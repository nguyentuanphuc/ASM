<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - PHONG CÁCH CHATGPT SIÊU SẮC NÉT -->
    <style name="Base.Theme.ASM" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Chữ đen đặc trên nền trắng để nhìn rõ nhất -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/white</item>
        
        <!-- Loại bỏ thanh tiêu đề và các màu mờ nhạt -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Màu văn bản mặc định cho toàn bộ ứng dụng -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="Theme.ASM" parent="Base.Theme.ASM" />
</resources>